# =============================================================================
# Argus — Root .gitignore
# =============================================================================
# This file is intentionally strict. Better to occasionally git-add -f a
# legitimate file than to accidentally commit a secret or a build artefact
# containing absolute paths.
# =============================================================================

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
jspm_packages/

# ── Build outputs (may contain absolute source paths in source maps) ────────
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
*.tsbuildinfo

# ── Turborepo cache ─────────────────────────────────────────────────────────
.turbo/

# ── Test outputs ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright/.cache/

# ── Environment files (NEVER COMMIT) ────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template
.envrc

# ── Secrets, keys, certificates ─────────────────────────────────────────────
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
secrets/
.secrets/
private/

# ── Database files (local SQLite often contains real data) ──────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal
*.db-wal
*.db-shm

# ── Local SQLite migrations from dev (use migrations/ folder only) ──────────
data/
storage/

# ── Local agent working files (these are private, per-agent scratch) ────────
.work/
.scratch/
.notes/

# ── IDE & editor (may contain absolute workspace paths) ─────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.ipr
*.iws
.fleet/
.zed/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime / process files ─────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
.cache/

# ── Optional npm cache directories ──────────────────────────────────────────
.npm
.eslintcache
.stylelintcache
.parcel-cache/

# ── Python (used by some build scripts and skills) ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
.python-version
venv/
.venv/

# ── Docker volumes ──────────────────────────────────────────────────────────
.docker-volumes/

# ── Local config that should never propagate ────────────────────────────────
.local/
local.*
*.local.*
*.local

# ── Backup files ────────────────────────────────────────────────────────────
*.bak
*.backup
*.old
*.orig
*.tmp

# ── Compressed archives (rarely belong in git) ──────────────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ── Generated documentation (regenerate from source) ────────────────────────
docs-site/build/
docs-site/.docusaurus/

# ── Auto-generated rule reference (regenerate from TSDoc) ───────────────────
docs/rules/generated/

# ── Scan output from running Argus locally ───────────────────────────
scan-output/
*.sarif
argus-report.*

# ── Test fixtures may contain real-looking secrets — protect them ───────────
# (Real secrets in fixtures must use the @argus/testing test-secret
# helper which generates deterministic obviously-fake values)
**/fixtures/**/.env
**/fixtures/**/credentials.json

# ── Reports / exports generated by the tool itself ──────────────────────────
reports/
exports/

# ── Specific paths to never include (defence in depth) ──────────────────────
# These should never exist in the repo, but the .gitignore catches them if
# someone accidentally creates one with a typo or shell mishap.
/home/
/Users/
/root/
/tmp/
/var/
C:\\
