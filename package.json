{
  "name": "argus",
  "version": "0.0.0",
  "private": true,
  "description": "Argus — architecture-aware code quality platform (monorepo root)",
  "license": "MIT",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "argus": "node apps/cli/bin/argus.mjs",
    "build": "turbo run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:packages": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "mutation": "stryker run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "license-check": "node scripts/check-licenses.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "handover:rotate": "node scripts/rotate-handover.mjs",
    "handover:check": "node scripts/rotate-handover.mjs --check",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rimraf node_modules .turbo coverage .stryker-tmp reports",
    "prepare": "husky && ./scripts/install-gitleaks.sh"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@vitest/coverage-v8": "4.1.9",
    "dependency-cruiser": "18.0.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "license-checker": "25.0.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "rimraf": "^5.0.10",
    "turbo": "^2.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
