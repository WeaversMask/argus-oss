{
  "name": "@argus/ast",
  "version": "0.0.0",
  "private": true,
  "description": "Tree-sitter adapter for the Argus AST port — parses TypeScript, JavaScript, and Python into the domain's AstNode view (wasm build, no native compiles).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage .turbo node_modules/.cache"
  },
  "dependencies": {
    "@argus/core": "workspace:*",
    "neverthrow": "8.2.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.26.12"
  },
  "devDependencies": {
    "@argus/testing": "workspace:*",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.10",
    "rimraf": "^5.0.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
