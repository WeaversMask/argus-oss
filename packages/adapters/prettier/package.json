{
  "name": "@argus/adapters-prettier",
  "version": "0.0.0",
  "private": true,
  "description": "Prettier adapter for the Argus FormatterPort — formats source text using the target project's own Prettier config, for argus fix's finishing pass.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage .turbo node_modules/.cache"
  },
  "dependencies": {
    "@argus/core": "workspace:*",
    "neverthrow": "8.2.0",
    "prettier": "3.9.6"
  },
  "devDependencies": {
    "@argus/testing": "workspace:*",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.10",
    "rimraf": "^5.0.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
