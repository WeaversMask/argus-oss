{
  "name": "@argus/api-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Argus wire contracts — zod schemas and inferred types for everything Argus emits to a machine: today the JSON scan report, later the HTTP API payloads shared by server and UI.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage .turbo node_modules/.cache"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@argus/testing": "workspace:*",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.9",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
