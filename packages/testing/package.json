{
  "name": "@argus/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest configuration, custom matchers, fixtures, and test utilities for the Argus monorepo.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./setup": {
      "types": "./src/setup.ts",
      "default": "./src/setup.ts"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf coverage .turbo node_modules/.cache"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "peerDependencies": {
    "@argus/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.10",
    "rimraf": "^5.0.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
