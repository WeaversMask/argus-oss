#!/usr/bin/env sh
# Argus pre-push hook
#
# Second-layer secret scan: gitleaks over every commit that is about to
# leave the machine. Pre-commit scans staged content, but a SKIP=gitleaks
# commit or history rewritten after the fact (rebase, amend) can slip past
# it — this hook closes that gap by scanning the exact outgoing range per
# pushed ref, so nothing unscanned lands on the remote.
#
# Bypass (requires written justification in the PR — see
# docs/SECURITY-NOTES.md §SKIP policy):
#   SKIP=gitleaks git push ...
#
# stdin (from git): one line per ref being pushed —
#   <local-ref> <local-sha> <remote-ref> <remote-sha>

set -e

skip_normalized=$(printf '%s' "${SKIP:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
case ",${skip_normalized}," in
  *",gitleaks,"*)
    echo "⚠️  pre-push: SKIP=gitleaks — bypassing outgoing-range secret scan. Document the reason in the PR."
    exit 0
    ;;
esac

repo_root="$(git rev-parse --show-toplevel)"

gitleaks_bin=""
if [ -x "$repo_root/.bin/gitleaks" ]; then
  gitleaks_bin="$repo_root/.bin/gitleaks"
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks_bin="gitleaks"
else
  echo "❌ pre-push: gitleaks not found."
  echo "   Run: ./scripts/install-gitleaks.sh"
  echo "   Or install system-wide (brew install gitleaks) and retry."
  echo "   To bypass once (requires justification): SKIP=gitleaks git push ..."
  exit 1
fi

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote ref pushes no commits — nothing to scan.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # New remote ref: scan every commit not already on a remote-tracking
    # ref (i.e. everything this push would publish for the first time).
    # Deliberately broader than origin/main..HEAD so pushes to a second
    # remote are covered too, at the cost of a bigger first scan — a
    # conscious breadth/cost tradeoff, do not narrow it (#14 review).
    range="$local_sha --not --remotes"
  elif ! git rev-parse --verify -q "${remote_sha}^{commit}" >/dev/null 2>&1; then
    # The remote-tracking SHA git handed us is stale, pruned, or from a
    # never-fetched remote. A range built on it makes gitleaks error out
    # internally while still exiting 0 (#14 review, major finding) — fall
    # back to the conservative new-ref range instead of trusting it.
    echo "⚠️  pre-push: remote SHA for $local_ref does not resolve locally — scanning all not-yet-remote commits instead."
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # gitleaks exits 0 on internal/git errors while logging ERR + "no leaks
  # found" (verified on the pinned version; #14 review, major finding).
  # Capture the output and fail CLOSED on any ERR line, not just on the
  # exit code — a scan that never ran must block, not pass.
  scan_status=0
  scan_output=$("$gitleaks_bin" detect --redact --no-banner \
    --config "$repo_root/.gitleaks.toml" \
    --source "$repo_root" \
    --log-opts "$range" 2>&1) || scan_status=$?
  printf '%s\n' "$scan_output"
  if [ "$scan_status" -ne 0 ]; then
    echo "❌ pre-push: gitleaks flagged potential secrets in the outgoing commits ($local_ref)."
    echo "   Nothing was pushed — git aborts every ref in this push together."
    echo "   Scrub the offending commits before retrying (docs/SECURITY-NOTES.md)."
    exit 1
  fi
  if printf '%s' "$scan_output" | grep -q "ERR"; then
    echo "❌ pre-push: gitleaks reported an internal error — the scan did not complete; failing closed."
    echo "   Nothing was pushed — git aborts every ref in this push together."
    echo "   Fix the underlying git/gitleaks problem, or bypass once with justification: SKIP=gitleaks git push ..."
    exit 1
  fi
done

exit 0
