#!/usr/bin/env sh
# Argus pre-commit hook
#
# Staged-scope quality gates via lint-staged (ESLint check + Prettier
# auto-fix with re-stage), then a gitleaks secret scan of the staged
# changes. Gitleaks runs last so it scans what will actually be committed
# (post-Prettier content). CI keeps the full-repo lint/format jobs as the
# backstop.
#
# Each gate can be skipped individually via the SKIP env var (comma-separated):
#   SKIP=lint git commit ...      (skips ESLint)
#   SKIP=format git commit ...    (skips Prettier)
#   SKIP=gitleaks git commit ...  (skips secret scan)
#   SKIP=lint,format,gitleaks git commit ...
#
# Skipping any of these requires justification in the commit message. See
# docs/SECURITY-NOTES.md for the SKIP=gitleaks policy specifically.

set -e

is_skipped() {
  case ",${SKIP}," in
    *",$1,"*) return 0 ;;
    *)        return 1 ;;
  esac
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if is_skipped lint; then
  echo "⚠️  pre-commit: SKIP=lint — bypassing eslint on staged files"
fi
if is_skipped format; then
  echo "⚠️  pre-commit: SKIP=format — bypassing prettier on staged files"
fi

if is_skipped lint && is_skipped format; then
  : # both quality gates skipped — nothing for lint-staged to do
else
  # lint-staged.config.mjs reads SKIP and drops the corresponding task.
  pnpm exec lint-staged --config lint-staged.config.mjs
fi

if is_skipped gitleaks; then
  echo "⚠️  pre-commit: SKIP=gitleaks — bypassing secret scan. Document the reason in the commit message."
else
  gitleaks_bin=""
  if [ -x "$repo_root/.bin/gitleaks" ]; then
    gitleaks_bin="$repo_root/.bin/gitleaks"
  elif command -v gitleaks >/dev/null 2>&1; then
    gitleaks_bin="gitleaks"
  else
    echo "❌ pre-commit: gitleaks not found."
    echo "   Run: ./scripts/install-gitleaks.sh"
    echo "   Or install system-wide (brew install gitleaks) and retry."
    echo "   To bypass once (requires justification): SKIP=gitleaks git commit ..."
    exit 1
  fi
  "$gitleaks_bin" protect --staged --redact --config "$repo_root/.gitleaks.toml" --no-banner
fi
